  "rules": {
    "annual_step": "Next population = present population + rounded births - rounded ordinary deaths + recorded net migration + exceptional event adjustments.",
    "ordinary_mortality": "Includes ordinary disease, engineered-wildlife hazards and recurrent low-level conflict. Named disasters and exceptional attacks are separate adjustments, applied once.",
    "migration": "Internal migration must debit an origin and credit a destination by the same number.",
    "subsets": "City populations and Cressault are included within the listed census groups. No double counting.",
    "time": "Advance only with elapsed story time; opening the phone app never advances the census.",
    "review": "Rates are current annual trends, reviewed when conditions change; they are not an automatic centuries-long forecast."
  },
